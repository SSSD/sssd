#. type: Content of: <reference><refentry><refsect1><refsect2><title>
#: sssd.conf.5.xml:227
msgid "Options usable in SERVICE and DOMAIN sections"
msgstr "Opcions que es poden utilitzar a les seccions SERVEI i DOMINI"

#. type: Content of: <reference><refentry><refsect1><refsect2><para><variablelist><varlistentry><term>
#: sssd.conf.5.xml:231
msgid "timeout (integer)"
msgstr "timeout (enter)"

#. type: Content of: <reference><refentry><refsect1><refsect2><para><variablelist><varlistentry><listitem><para>
#: sssd.conf.5.xml:234
msgid ""
"Timeout in seconds between heartbeats for this service. This is used to "
"ensure that the process is alive and capable of answering requests. Note "
"that after three missed heartbeats the process will terminate itself."
msgstr ""
"Temps d'espera en segons entre batecs cardíacs per a aquest servei. Això "
"s'utilitza per assegurar que el procés és viu i capaç de respondre les "
"sol·licituds. Tingueu en compte que després de tres batecs cardíacs perduts, "
"el procés acabarà per si mateix."

#. type: Content of: <refsect1><refsect2><refsect3><variablelist><varlistentry><listitem><para>
#: sssd.conf.5.xml:241 sssd.conf.5.xml:1214 sssd.conf.5.xml:1724
#: sssd.conf.5.xml:4466 sssd-ldap.5.xml:825 sssd-idp.5.xml:271
#: include/ldap_id_mapping.xml:270
msgid "Default: 10"
msgstr "Per defecte: 10"

