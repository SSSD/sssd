#: sssd.conf.5.xml:4038
msgid "Smartcard"
msgstr "Smartcard"

#. type: Content of: <reference><refentry><refsect1><para><variablelist><varlistentry><listitem><para><itemizedlist><listitem><para>
#: sssd.conf.5.xml:4041 sssd-ldap.5.xml:189
msgid "IPA"
msgstr "IPA"

