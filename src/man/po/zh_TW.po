#, no-wrap
msgid ""
"[domain/shadowutils]\n"
"id_provider = proxy\n"
"proxy_lib_name = files\n"
"auth_provider = none\n"
"local_auth_policy = only\n"
msgstr ""
"[domain/shadowutils]\n"
"id_provider = proxy\n"
"proxy_lib_name = files\n"
"auth_provider = none\n"
"local_auth_policy = only\n"

