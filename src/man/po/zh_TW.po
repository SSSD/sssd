"optional> <optional><option>-g,--gid</option> GID</optional> <optional>"
"<option>-h,--home</option> HOME</optional> <optional><option>-s,--shell</"
"option> SHELL</optional> <optional><option>-c,--gecos</option> GECOS</"
"optional> <optional><option>-x,--certificate</option> BASE64 ENCODED "
"CERTIFICATE</optional>"

#. type: Content of: <reference><refentry><refsect1><variablelist><varlistentry><listitem><para>
#: sss_override.8.xml:78
msgid ""
