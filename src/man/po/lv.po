msgstr ""
"Piezīme: grupu politikas pārvaldības redaktorā šī vērtība saucas \"Allow log "
"on as a service\" un \"Deny log on as a service\"."

#. type: Content of: <reference><refentry><refsect1><para><variablelist><varlistentry><listitem><para><programlisting>
#: sssd-ad.5.xml:922
#, no-wrap
msgid ""
"ad_gpo_map_service = +my_pam_service\n"
"                            "
msgstr ""
