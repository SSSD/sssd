/var/log/sssd/*.log {
    weekly
    missingok
    notifempty
    sharedscripts
    rotate 2
    compress
    delaycompress
    su @SSSD_USER@ @SSSD_USER@
    postrotate
        # A generic postrotate script that can be used with and without systemd.
        # The decision whether systemd is supported is made at build time and
        # hardcoded in the installed script.
        SYSTEMD="@logrotate_systemd@"
        if [ "$SYSTEMD" = "yes" ]; then
            systemctl kill --signal=HUP --kill-whom=main sssd.service sssd-kcm.service 2>/dev/null || true
        else
            kill -HUP $(cat @pidpath@/sssd.pid 2>/dev/null) 2> /dev/null || true
            pkill -HUP sssd_kcm 2> /dev/null || true
        fi
    endscript
}
