#: src/config/SSSDConfig/sssdoptions.py:16
#: src/config/SSSDConfig/sssdoptions.py:17
msgid "Set the verbosity of the debug logging"
msgstr "Iestatīt atkļūdošanas žurnāla detalizācijas līmeni"

#: src/config/SSSDConfig/sssdoptions.py:18
msgid "Include timestamps in debug logs"
msgstr "Iekļaut laikspiedolus atkļūdošanas žurnālos"

#: src/config/SSSDConfig/sssdoptions.py:19
msgid "Include microseconds in timestamps in debug logs"
msgstr "Iekļaut mikrosekundes laikspiedolos atkļūdošanas žurnālos"

#: src/config/SSSDConfig/sssdoptions.py:20
msgid "Enable/disable debug backtrace"
msgstr "Iespējot/atspējot atkļūdošanas atpakaļsekojumu"

#: src/config/SSSDConfig/sssdoptions.py:21
msgid "Watchdog timeout before restarting service"
msgstr "Sargsuņa noildze pirms pakalpojuma restartēšanas"

#: src/config/SSSDConfig/sssdoptions.py:22
msgid "Command to start service"
msgstr "Komanda pakalpojuma palaišanai"

#: src/config/SSSDConfig/sssdoptions.py:23
msgid "The number of file descriptors that may be opened by this responder"
msgstr "Failu deskriptoru skaits, ko var atvērt šis atbildētājs"

#: src/config/SSSDConfig/sssdoptions.py:24
msgid "Idle time before automatic disconnection of a client"
msgstr "Dīkstāves laiks pirms klienta automātiskas atvienošanas"

#: src/config/SSSDConfig/sssdoptions.py:25
msgid "Idle time before automatic shutdown of the responder"
msgstr "Dīkstāves laiks pirms atbildētāja automātiskas izslēgšanas"

#: src/config/SSSDConfig/sssdoptions.py:26
msgid "Always query all the caches before querying the Data Providers"
msgstr "Vienmēr vaicāt visās kešatmiņās pirms vaicāšanas datu nodrošinātājiem"

#: src/config/SSSDConfig/sssdoptions.py:27
msgid ""
"When SSSD switches to offline mode the amount of time before it tries to go "
"back online will increase based upon the time spent disconnected. This value "
"is in seconds and calculated by the following: offline_timeout + "
"random_offset."
msgstr ""
"Kad SSSD pārslēdzas bezsaistes režīmā, laiks līdz mēģinājumam atgriezties "
"tiešsaistē palielināsies atkarībā no atvienotajā stāvoklī pavadītā laika. Šī "
"vērtība ir sekundēs, un to aprēķina šādi: offline_timeout + random_offset."

#: src/config/SSSDConfig/sssdoptions.py:32
msgid "SSSD Services to start"
msgstr "Palaižamie SSSD pakalpojumi"

#: src/config/SSSDConfig/sssdoptions.py:33
msgid "SSSD Domains to start"
msgstr "Palaižamie SSSD domēni"

#: src/config/SSSDConfig/sssdoptions.py:34
msgid "Regex to parse username and domain"
msgstr "Regulārā izteiksme lietotājvārda un domēna parsēšanai"

#: src/config/SSSDConfig/sssdoptions.py:35
msgid "Printf-compatible format for displaying fully-qualified names"
msgstr "Ar printf saderīgs formāts pilnībā kvalificētu nosaukumu attēlošanai"

#: src/config/SSSDConfig/sssdoptions.py:36
msgid ""
"Directory on the filesystem where SSSD should store Kerberos replay cache "
"files."
msgstr ""
"Direktorija failu sistēmā, kurā SSSD jāglabā Kerberos atkārtojumu kešatmiņas "
"faili."

#: src/config/SSSDConfig/sssdoptions.py:37
msgid "Domain to add to names without a domain component."
msgstr "Domēns, ko pievienot nosaukumiem bez domēna daļas."

#: src/config/SSSDConfig/sssdoptions.py:38
msgid "The user to drop privileges to"
msgstr "Lietotājs, uz kuru samazināt privilēģijas"

#: src/config/SSSDConfig/sssdoptions.py:39
msgid "Tune certificate verification"
msgstr "Pielāgot sertifikātu verifikāciju"

#: src/config/SSSDConfig/sssdoptions.py:40
msgid "All spaces in group or user names will be replaced with this character"
msgstr ""
"Visas atstarpes grupu vai lietotāju nosaukumos tiks aizstātas ar šo rakstzīmi"

#: src/config/SSSDConfig/sssdoptions.py:41
msgid "Tune sssd to honor or ignore netlink state changes"
msgstr "Pielāgot, vai sssd ievēro vai ignorē netlink stāvokļa izmaiņas"

#: src/config/SSSDConfig/sssdoptions.py:42
msgid "Enable or disable the implicit files domain"
msgstr "Iespējot vai atspējot netiešo failu domēnu"

#: src/config/SSSDConfig/sssdoptions.py:43
msgid "A specific order of the domains to be looked up"
msgstr "Konkrēta domēnu uzmeklēšanas secība"

#: src/config/SSSDConfig/sssdoptions.py:44
msgid ""
"Controls if SSSD should monitor the state of resolv.conf to identify when it "
"needs to update its internal DNS resolver."
msgstr ""
"Nosaka, vai SSSD jāuzrauga resolv.conf stāvoklis, lai noteiktu, kad "
"jāatjaunina iekšējais DNS atrisinātājs."

#: src/config/SSSDConfig/sssdoptions.py:46
msgid ""
"SSSD monitors the state of resolv.conf to identify when it needs to update "
"its internal DNS resolver. By default, we will attempt to use inotify for "
"this, and will fall back to polling resolv.conf every five seconds if "
"inotify cannot be used."
msgstr ""
"SSSD uzrauga resolv.conf stāvokli, lai noteiktu, kad jāatjaunina iekšējais "
"DNS atrisinātājs. Pēc noklusējuma tam tiek mēģināts izmantot inotify, un, ja "
"inotify nevar izmantot, ik pēc piecām sekundēm tiek aptaujāts resolv.conf."

#: src/config/SSSDConfig/sssdoptions.py:49
msgid "Run PAC responder automatically for AD and IPA provider"
msgstr "Automātiski palaist PAC atbildētāju AD un IPA nodrošinātājam"

#: src/config/SSSDConfig/sssdoptions.py:50
msgid "Enable or disable core dumps for all SSSD processes."
msgstr "Iespējot vai atspējot kodola izmetes visiem SSSD procesiem."

#: src/config/SSSDConfig/sssdoptions.py:51
msgid "Tune passkey verification behavior"
msgstr "Pielāgot piekļuves atslēgas verifikācijas darbību"

#: src/config/SSSDConfig/sssdoptions.py:54
msgid "Enumeration cache timeout length (seconds)"
msgstr "Uzskaitīšanas kešatmiņas noildzes ilgums (sekundes)"

#: src/config/SSSDConfig/sssdoptions.py:55
msgid "Entry cache background update timeout length (seconds)"
msgstr "Ierakstu kešatmiņas fona atjaunināšanas noildzes ilgums (sekundes)"

#: src/config/SSSDConfig/sssdoptions.py:56
#: src/config/SSSDConfig/sssdoptions.py:126
msgid "Negative cache timeout length (seconds)"
msgstr "Negatīvās kešatmiņas noildzes ilgums (sekundes)"

#: src/config/SSSDConfig/sssdoptions.py:57
msgid "UIDs or UID ranges that SSSD should explicitly ignore"
msgstr "UID vai UID diapazoni, kurus SSSD eksplicīti jāignorē"

#: src/config/SSSDConfig/sssdoptions.py:58
msgid "GIDs or GID ranges that SSSD should explicitly ignore"
msgstr "GID vai GID diapazoni, kurus SSSD eksplicīti jāignorē"

#: src/config/SSSDConfig/sssdoptions.py:59
msgid "Users that SSSD should explicitly ignore"
msgstr "Lietotāji, kurus SSSD eksplicīti jāignorē"

#: src/config/SSSDConfig/sssdoptions.py:60
msgid "Groups that SSSD should explicitly ignore"
msgstr "Grupas, kuras SSSD eksplicīti jāignorē"

#: src/config/SSSDConfig/sssdoptions.py:61
msgid "Should filtered users appear in groups"
msgstr "Vai filtrētajiem lietotājiem jāparādās grupās"

#: src/config/SSSDConfig/sssdoptions.py:62
msgid "The value of the password field the NSS provider should return"
msgstr "Paroles lauka vērtība, kas NSS nodrošinātājam jāatgriež"

#: src/config/SSSDConfig/sssdoptions.py:63
msgid "Override homedir value from the identity provider with this value"
msgstr ""
"Aizstāt identitātes nodrošinātāja mājas direktorijas vērtību ar šo vērtību"

#: src/config/SSSDConfig/sssdoptions.py:64
msgid ""
"Substitute empty homedir value from the identity provider with this value"
msgstr ""
"Aizstāt tukšu identitātes nodrošinātāja mājas direktorijas vērtību ar šo "
"vērtību"

#: src/config/SSSDConfig/sssdoptions.py:65
msgid "Override shell value from the identity provider with this value"
msgstr "Aizstāt identitātes nodrošinātāja čaulas vērtību ar šo vērtību"

#: src/config/SSSDConfig/sssdoptions.py:66
msgid "The list of shells users are allowed to log in with"
msgstr "Čaulu saraksts, ar kurām lietotājiem atļauts pieteikties"

#: src/config/SSSDConfig/sssdoptions.py:67
msgid ""
"The list of shells that will be vetoed, and replaced with the fallback shell"
msgstr "Čaulu saraksts, kuras tiks noraidītas un aizstātas ar rezerves čaulu"

#: src/config/SSSDConfig/sssdoptions.py:68
msgid ""
"If a shell stored in central directory is allowed but not available, use "
"this fallback"
msgstr ""
"Ja centrālajā direktorijā glabātā čaula ir atļauta, bet nav pieejama, "
"izmantot šo rezerves čaulu"

#: src/config/SSSDConfig/sssdoptions.py:69
msgid "Shell to use if the provider does not list one"
msgstr "Čaula, ko izmantot, ja nodrošinātājs to nenorāda"

#: src/config/SSSDConfig/sssdoptions.py:70
msgid "How long will be in-memory cache records valid"
msgstr "Cik ilgi atmiņas kešatmiņas ieraksti būs derīgi"

#: src/config/SSSDConfig/sssdoptions.py:72
msgid ""
"Size (in megabytes) of the data table allocated inside fast in-memory cache "
"for passwd requests"
msgstr ""
"Datu tabulas izmērs (megabaitos), kas piešķirts ātrajā atmiņas kešatmiņā "
"passwd pieprasījumiem"

#: src/config/SSSDConfig/sssdoptions.py:74
msgid ""
"Size (in megabytes) of the data table allocated inside fast in-memory cache "
"for group requests"
msgstr ""
"Datu tabulas izmērs (megabaitos), kas piešķirts ātrajā atmiņas kešatmiņā "
"group pieprasījumiem"

#: src/config/SSSDConfig/sssdoptions.py:76
msgid ""
"Size (in megabytes) of the data table allocated inside fast in-memory cache "
"for initgroups requests"
msgstr ""
"Datu tabulas izmērs (megabaitos), kas piešķirts ātrajā atmiņas kešatmiņā "
"initgroups pieprasījumiem"

#: src/config/SSSDConfig/sssdoptions.py:77
msgid ""
"The value of this option will be used in the expansion of the "
"override_homedir option if the template contains the format string %H."
msgstr ""
"Šīs opcijas vērtība tiks izmantota opcijas override_homedir izvēršanā, ja "
"veidne satur formāta virkni %H."

#: src/config/SSSDConfig/sssdoptions.py:79
msgid ""
"Specifies time in seconds for which the list of subdomains will be "
"considered valid."
msgstr ""
"Norāda laiku sekundēs, cik ilgi apakšdomēnu saraksts tiks uzskatīts par "
"derīgu."

#: src/config/SSSDConfig/sssdoptions.py:81
msgid ""
"The entry cache can be set to automatically update entries in the background "
"if they are requested beyond a percentage of the entry_cache_timeout value "
"for the domain."
msgstr ""
"Ierakstu kešatmiņu var iestatīt automātiski atjaunināt ierakstus fonā, ja "
"tie tiek pieprasīti pēc noteiktas domēna entry_cache_timeout vērtības "
"procentuālās daļas."

#: src/config/SSSDConfig/sssdoptions.py:86
msgid "How long to allow cached logins between online logins (days)"
msgstr ""
"Cik ilgi atļaut kešotas pieteikšanās starp tiešsaistes pieteikšanās reizēm "
"(dienas)"

#: src/config/SSSDConfig/sssdoptions.py:87
msgid "How many failed logins attempts are allowed when offline"
msgstr "Cik neveiksmīgu pieteikšanās mēģinājumu atļauts bezsaistē"

#: src/config/SSSDConfig/sssdoptions.py:89
msgid ""
"How long (minutes) to deny login after offline_failed_login_attempts has "
"been reached"
msgstr ""
"Cik ilgi (minūtes) liegt pieteikšanos pēc offline_failed_login_attempts "
"sasniegšanas"

#: src/config/SSSDConfig/sssdoptions.py:90
msgid "What kind of messages are displayed to the user during authentication"
msgstr "Kāda veida ziņojumi autentifikācijas laikā tiek rādīti lietotājam"

#: src/config/SSSDConfig/sssdoptions.py:91
msgid "Filter PAM responses sent to the pam_sss"
msgstr "Filtrēt uz pam_sss sūtītās PAM atbildes"

#: src/config/SSSDConfig/sssdoptions.py:92
msgid "How many seconds to keep identity information cached for PAM requests"
msgstr ""
"Cik sekundes PAM pieprasījumiem glabāt kešatmiņā identitātes informāciju"

#: src/config/SSSDConfig/sssdoptions.py:93
msgid "How many days before password expiration a warning should be displayed"
msgstr "Cik dienas pirms paroles derīguma beigām jārāda brīdinājums"

#: src/config/SSSDConfig/sssdoptions.py:94
msgid "List of trusted uids or user's name"
msgstr "Uzticamo UID vai lietotājvārdu saraksts"

#: src/config/SSSDConfig/sssdoptions.py:95
msgid "List of domains accessible even for untrusted users."
msgstr "Domēnu saraksts, kas pieejami arī neuzticamiem lietotājiem."

#: src/config/SSSDConfig/sssdoptions.py:96
msgid "Message printed when user account is expired."
msgstr "Ziņojums, kas tiek izvadīts, kad lietotāja kontam beidzies derīgums."

#: src/config/SSSDConfig/sssdoptions.py:97
msgid "Message printed when user account is locked."
msgstr "Ziņojums, kas tiek izvadīts, kad lietotāja konts ir bloķēts."

#: src/config/SSSDConfig/sssdoptions.py:98
msgid "Allow certificate based/Smartcard authentication."
msgstr "Atļaut autentifikāciju ar sertifikātu/viedkarti."

#: src/config/SSSDConfig/sssdoptions.py:99
msgid "Path to certificate database with PKCS#11 modules."
msgstr "Ceļš uz sertifikātu datubāzi ar PKCS#11 moduļiem."

#: src/config/SSSDConfig/sssdoptions.py:100
msgid "Tune certificate verification for PAM authentication."
msgstr "Pielāgot sertifikātu verifikāciju PAM autentifikācijai."

#: src/config/SSSDConfig/sssdoptions.py:101
msgid "How many seconds will pam_sss wait for p11_child to finish"
msgstr "Cik sekundes pam_sss gaidīs, līdz p11_child beigs darbu"

#: src/config/SSSDConfig/sssdoptions.py:102
msgid "Which PAM services are permitted to contact application domains"
msgstr "Kuriem PAM pakalpojumiem atļauts sazināties ar lietotņu domēniem"

#: src/config/SSSDConfig/sssdoptions.py:103
msgid "Allowed services for using smartcards"
msgstr "Atļautie pakalpojumi viedkaršu izmantošanai"

#: src/config/SSSDConfig/sssdoptions.py:104
msgid "Additional timeout to wait for a card if requested"
msgstr "Papildu noildze, ko gaidīt karti, ja tas pieprasīts"

#: src/config/SSSDConfig/sssdoptions.py:105
msgid ""
"PKCS#11 URI to restrict the selection of devices for Smartcard authentication"
msgstr "PKCS#11 URI, lai ierobežotu ierīču izvēli viedkartes autentifikācijai"

#: src/config/SSSDConfig/sssdoptions.py:106
msgid "When shall the PAM responder force an initgroups request"
msgstr "Kad PAM atbildētājam jāpiespiež initgroups pieprasījums"

#: src/config/SSSDConfig/sssdoptions.py:107
msgid "List of PAM services that are allowed to authenticate with GSSAPI."
msgstr "PAM pakalpojumu saraksts, kuriem atļauts autentificēties ar GSSAPI."

#: src/config/SSSDConfig/sssdoptions.py:108
msgid "Whether to match authenticated UPN with target user"
msgstr "Vai salīdzināt autentificēto UPN ar mērķa lietotāju"

#: src/config/SSSDConfig/sssdoptions.py:109
msgid ""
"List of pairs <PAM service>:<authentication indicator> that must be enforced "
"for PAM access with GSSAPI authentication"
msgstr ""
"Pāru <PAM service>:<authentication indicator> saraksts, kas jāpiemēro PAM "
"piekļuvei ar GSSAPI autentifikāciju"

#: src/config/SSSDConfig/sssdoptions.py:111
msgid ""
"List of triples <type>:<value>:<authentication indicator> that assigns "
"additional information from the Kerberos ticket to an authentication "
"indicator."
msgstr ""
"Trijnieku <type>:<value>:<authentication indicator> saraksts, kas piešķir "
"autentifikācijas indikatoram papildu informāciju no Kerberos biļetes."

#: src/config/SSSDConfig/sssdoptions.py:114
msgid "Allow passkey device authentication."
msgstr "Atļaut autentifikāciju ar piekļuves atslēgas ierīci."

#: src/config/SSSDConfig/sssdoptions.py:115
msgid "How many seconds will pam_sss wait for passkey_child to finish"
msgstr "Cik sekundes pam_sss gaidīs, līdz passkey_child beigs darbu"

#: src/config/SSSDConfig/sssdoptions.py:116
msgid "Enable debugging in the libfido2 library"
msgstr "Iespējot atkļūdošanu bibliotēkā libfido2"

#: src/config/SSSDConfig/sssdoptions.py:117
msgid "Enable JSON protocol for authentication methods selection."
msgstr "Iespējot JSON protokolu autentifikācijas metožu izvēlei."

#: src/config/SSSDConfig/sssdoptions.py:120
msgid "Whether to evaluate the time-based attributes in sudo rules"
msgstr "Vai novērtēt sudo kārtulu laika atribūtus"

#: src/config/SSSDConfig/sssdoptions.py:121
msgid "If true, SSSD will switch back to lower-wins ordering logic"
msgstr "Ja true, SSSD atgriezīsies pie kārtošanas loģikas „uzvar mazākais”"

#: src/config/SSSDConfig/sssdoptions.py:122
msgid ""
"Maximum number of rules that can be refreshed at once. If this is exceeded, "
"full refresh is performed."
msgstr ""
"Maksimālais kārtulu skaits, ko var atsvaidzināt vienlaikus. Ja tas tiek "
"pārsniegts, tiek veikta pilna atsvaidzināšana."

#: src/config/SSSDConfig/sssdoptions.py:129
msgid "Whether to hash host names and addresses in the known_hosts file"
msgstr "Vai failā known_hosts jaukt resursdatoru nosaukumus un adreses"

#: src/config/SSSDConfig/sssdoptions.py:130
msgid ""
"How many seconds to keep a host in the known_hosts file after its host keys "
"were requested"
msgstr ""
"Cik sekundes glabāt resursdatoru failā known_hosts pēc tā resursdatora "
"atslēgu pieprasīšanas"

#: src/config/SSSDConfig/sssdoptions.py:132
msgid "Path to storage of trusted CA certificates"
msgstr "Ceļš uz uzticamo CA sertifikātu krātuvi"

#: src/config/SSSDConfig/sssdoptions.py:133
msgid "Allow to generate ssh-keys from certificates"
msgstr "Atļaut ģenerēt ssh atslēgas no sertifikātiem"

#: src/config/SSSDConfig/sssdoptions.py:134
msgid ""
"Use the following matching rules to filter the certificates for ssh-key "
"generation"
msgstr ""
"Izmantot šīs atbilstības kārtulas sertifikātu filtrēšanai ssh atslēgu "
"ģenerēšanai"

#: src/config/SSSDConfig/sssdoptions.py:138
msgid "List of UIDs or user names allowed to access the PAC responder"
msgstr "UID vai lietotājvārdu saraksts, kam atļauts piekļūt PAC atbildētājam"

#: src/config/SSSDConfig/sssdoptions.py:139
msgid "How long the PAC data is considered valid"
msgstr "Cik ilgi PAC dati tiek uzskatīti par derīgiem"

#: src/config/SSSDConfig/sssdoptions.py:140
msgid "Validate the PAC"
msgstr "Validēt PAC"

#: src/config/SSSDConfig/sssdoptions.py:143
msgid "List of user attributes the InfoPipe is allowed to publish"
msgstr "Lietotāju atribūtu saraksts, ko InfoPipe drīkst publicēt"

#: src/config/SSSDConfig/sssdoptions.py:146
msgid ""
"One of the following strings specifying the scope of session recording: none "
"- No users are recorded. some - Users/groups specified by users and groups "
"options are recorded. all - All users are recorded."
msgstr ""
"Viena no šīm virknēm, kas norāda sesiju ierakstīšanas tvērumu: none — "
"neviens lietotājs netiek ierakstīts. some — tiek ierakstīti opcijās users un "
"groups norādītie lietotāji/grupas. all — tiek ierakstīti visi lietotāji."

#: src/config/SSSDConfig/sssdoptions.py:149
msgid ""
"A comma-separated list of users which should have session recording enabled. "
"Matches user names as returned by NSS. I.e. after the possible space "
"replacement, case changes, etc."
msgstr ""
"Ar komatiem atdalīts lietotāju saraksts, kam jāiespējo sesiju ierakstīšana. "
"Atbilst lietotājvārdiem tā, kā tos atgriež NSS, t.i., pēc iespējamās "
"atstarpju aizstāšanas, reģistra maiņas utt."

#: src/config/SSSDConfig/sssdoptions.py:151
msgid ""
"A comma-separated list of groups, members of which should have session "
"recording enabled. Matches group names as returned by NSS. I.e. after the "
"possible space replacement, case changes, etc."
msgstr ""
"Ar komatiem atdalīts grupu saraksts, kuru dalībniekiem jāiespējo sesiju "
"ierakstīšana. Atbilst grupu nosaukumiem tā, kā tos atgriež NSS, t.i., pēc "
"iespējamās atstarpju aizstāšanas, reģistra maiņas utt."

#: src/config/SSSDConfig/sssdoptions.py:154
msgid ""
"A comma-separated list of users to be excluded from recording, only when "
"scope=all"
msgstr ""
"Ar komatiem atdalīts lietotāju saraksts, kas jāizslēdz no ierakstīšanas, "
"tikai ja scope=all"

#: src/config/SSSDConfig/sssdoptions.py:155
msgid ""
"A comma-separated list of groups, members of which should be excluded from "
"recording,  only when scope=all. "
msgstr ""
"Ar komatiem atdalīts grupu saraksts, kuru dalībnieki jāizslēdz no "
"ierakstīšanas,  tikai ja scope=all. "

#: src/config/SSSDConfig/sssdoptions.py:159
msgid "Identity provider"
msgstr "Identitātes nodrošinātājs"

#: src/config/SSSDConfig/sssdoptions.py:160
msgid "Authentication provider"
msgstr "Autentifikācijas nodrošinātājs"

#: src/config/SSSDConfig/sssdoptions.py:161
msgid "Access control provider"
msgstr "Piekļuves kontroles nodrošinātājs"

#: src/config/SSSDConfig/sssdoptions.py:162
msgid "Password change provider"
msgstr "Paroles maiņas nodrošinātājs"

#: src/config/SSSDConfig/sssdoptions.py:163
